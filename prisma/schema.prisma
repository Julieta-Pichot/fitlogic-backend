generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// CONFIGURACIÓN DEL GIMNASIO (registro único)
// ============================================================================
// Un solo row en toda la tabla. Incluye tanto los datos institucionales
// como los de soporte (Grupo I: se fusionan porque hoy el gimnasio y el
// soporte son la misma entidad). Si se edita, el cambio se refleja
// automáticamente en el pie de página del perfil del cliente, porque ambos
// leen el mismo registro — no hay que "propagar" nada manualmente.
model Gimnasio {
  id                 Int      @id @default(autoincrement())
  nombre             String   @db.VarChar(100)
  direccion          String?  @db.VarChar(200)
  telefono           String?  @db.VarChar(50)
  emailSoporte       String?  @map("email_soporte") @db.VarChar(150)
  identidadVisual    String?  @map("identidad_visual") @db.VarChar(255)
  fechaActualizacion DateTime @updatedAt @map("fecha_actualizacion")

  @@map("gimnasio")
}

// ============================================================================
// ROLES Y USUARIOS (identidad + autenticación)
// ============================================================================

// Catálogo de roles. Tabla en vez de enum (Grupo A): más flexible para el
// ORM/backend y permite agregar roles futuros sin migrar un enum.
model Rol {
  id       Int       @id @default(autoincrement())
  nombre   String    @unique @db.VarChar(50) // ADMIN | PROFESOR | RECEPCIONISTA | CLIENTE
  usuarios Usuario[]

  @@map("rol")
}

// Tabla de identidad y login. Una fila por persona, sin importar su rol.
// El email es único a nivel de todo el sistema (login unificado).
model Usuario {
  id            Int      @id @default(autoincrement())
  rolId         Int      @map("rol_id")
  nombre        String   @db.VarChar(100)
  apellido      String   @db.VarChar(100)
  email         String   @unique @db.VarChar(150)
  passwordHash  String   @map("password_hash") @db.VarChar(255)
  telefono      String?  @db.VarChar(50)
  activo        Boolean  @default(true)
  fechaCreacion DateTime @default(now()) @map("fecha_creacion")

  rol            Rol             @relation(fields: [rolId], references: [id])
  cliente        Cliente?
  profesor       Profesor?
  recepcionista  Recepcionista?
  notificaciones Notificacion[]

  // NOTA IMPORTANTE (Grupo F, opción b):
  // Si el rol de un Usuario cambia (ej. CLIENTE → PROFESOR), la fila anterior
  // en la tabla del rol viejo (Cliente, en este ejemplo) NO se conserva.
  // Esto es responsabilidad de la capa de aplicación: al cambiar `rolId`,
  // el backend debe eliminar la fila correspondiente al rol anterior antes
  // de (o al) crear la fila del nuevo rol. El schema no impide técnicamente
  // que un usuario tenga filas en más de una tabla de rol a la vez; esa
  // garantía la sostiene el backend, no la base de datos.

  @@map("usuario")
}

// ============================================================================
// CLIENTE
// ============================================================================

// Catálogo de estados del cliente. Reemplaza al de la BDD vieja
// (ACTIVO/PENDIENTE_PAGO/PENDIENTE_HABILITACION/BAJA), que quedó
// desactualizado. Un cliente nunca se borra: solo cambia de estado.
model EstadoCliente {
  id       Int       @id @default(autoincrement())
  nombre   String    @unique @db.VarChar(50) // HABILITADO | INHABILITADO_PAGO | INHABILITADO_BAJA
  clientes Cliente[]

  @@map("estado_cliente")
}

model Cliente {
  id              Int      @id @default(autoincrement())
  usuarioId       Int      @unique @map("usuario_id")
  estadoClienteId Int      @map("estado_cliente_id")

  // Objetivo de entrenamiento: texto libre cargado por el recepcionista al
  // dar de alta al cliente (Grupo E). Visible para el cliente, el profesor
  // y demás roles con acceso a su perfil.
  objetivoEntrenamiento String? @map("objetivo_entrenamiento") @db.VarChar(255)

  // Objetivo de racha: definido UNA SOLA VEZ por el propio cliente al
  // ingresar por primera vez al sistema. No modificable (por ahora).
  // La racha ACTUAL (cuántos días lleva cumpliendo este objetivo) NO se
  // persiste: se calcula en la aplicación a partir del historial de
  // Asistencia + este valor.
  objetivoDiasRacha Int @default(3) @map("objetivo_dias_racha")

  fechaAlta DateTime @default(now()) @map("fecha_alta") @db.Date

  // Apto físico embebido directamente en Cliente (Grupo C): sin historial,
  // cada carga nueva reemplaza a la anterior (UPDATE, no INSERT).
  // fechaVencimiento = fechaCarga + 1 año, calculado por el backend al
  // momento de la carga y persistido acá (no se recalcula en cada consulta).
  aptoFisicoArchivo         String?   @map("apto_fisico_archivo") @db.VarChar(255)
  aptoFisicoFechaCarga      DateTime? @map("apto_fisico_fecha_carga") @db.Date
  aptoFisicoFechaVencimiento DateTime? @map("apto_fisico_fecha_vencimiento") @db.Date

  usuario           Usuario             @relation(fields: [usuarioId], references: [id])
  estadoCliente     EstadoCliente       @relation(fields: [estadoClienteId], references: [id])
  cuotas            Cuota[]
  asistencias       Asistencia[]
  rutinas           Rutina[]
  inscripciones     InscripcionClase[]
  puntuaciones      PuntuacionClase[]

  @@map("cliente")
}

// ============================================================================
// PROFESOR Y RECEPCIONISTA (staff)
// ============================================================================

// Catálogo de estado de cuenta para staff (Profesor/Recepcionista).
// Distinto del de Cliente: administrado únicamente por el Admin (Grupo F).
model EstadoCuentaStaff {
  id             Int             @id @default(autoincrement())
  nombre         String          @unique @db.VarChar(50) // HABILITADO | INHABILITADO
  profesores     Profesor[]
  recepcionistas Recepcionista[]

  @@map("estado_cuenta_staff")
}

model Profesor {
  id                  Int    @id @default(autoincrement())
  usuarioId           Int    @unique @map("usuario_id")
  estadoCuentaStaffId Int    @map("estado_cuenta_staff_id")
  especialidad        String? @db.VarChar(100)

  usuario           Usuario           @relation(fields: [usuarioId], references: [id])
  estadoCuentaStaff EstadoCuentaStaff @relation(fields: [estadoCuentaStaffId], references: [id])

  // Todo lo que crea ESTE profesor puntual — nunca compartido con otros
  // profesores, aunque tengan el mismo rol.
  rutinasCreadas   Rutina[]
  ejerciciosCreados Ejercicio[]
  clases           Clase[]
  recetas          Receta[]

  @@map("profesor")
}

model Recepcionista {
  id                  Int @id @default(autoincrement())
  usuarioId           Int @unique @map("usuario_id")
  estadoCuentaStaffId Int @map("estado_cuenta_staff_id")

  usuario           Usuario           @relation(fields: [usuarioId], references: [id])
  estadoCuentaStaff EstadoCuentaStaff @relation(fields: [estadoCuentaStaffId], references: [id])

  @@map("recepcionista")
}

// ============================================================================
// PLANES, CUOTAS Y PAGOS
// ============================================================================

model Plan {
  id           Int     @id @default(autoincrement())
  nombre       String  @db.VarChar(100)
  duracionDias Int     @map("duracion_dias")
  precio       Decimal @db.Decimal(10, 2)
  activo       Boolean @default(true)

  cuotas      Cuota[]
  promociones Promocion[]

  @@map("plan")
}

// Catálogo de estados de cuota. PENDIENTE es el estado inicial obligatorio
// (Grupo H): ninguna cuota nace ACTIVA automáticamente, sin importar el
// medio de pago (efectivo o Mercado Pago) — siempre requiere confirmación.
model EstadoCuota {
  id     Int     @id @default(autoincrement())
  nombre String  @unique @db.VarChar(50) // PENDIENTE | ACTIVA | VENCIDA
  cuotas Cuota[]

  @@map("estado_cuota")
}

model Cuota {
  id            Int      @id @default(autoincrement())
  clienteId     Int      @map("cliente_id")
  planId        Int      @map("plan_id")
  estadoCuotaId Int      @map("estado_cuota_id")
  fechaInicio   DateTime @map("fecha_inicio") @db.Date
  fechaVencimiento DateTime @map("fecha_vencimiento") @db.Date

  cliente     Cliente     @relation(fields: [clienteId], references: [id])
  plan        Plan        @relation(fields: [planId], references: [id])
  estadoCuota EstadoCuota @relation(fields: [estadoCuotaId], references: [id])
  pago        Pago?

  @@map("cuota")
}

// Catálogo de métodos de pago (Grupo A: tabla, no enum).
model MetodoPago {
  id     Int    @id @default(autoincrement())
  nombre String @unique @db.VarChar(50) // EFECTIVO | MERCADO_PAGO
  pagos  Pago[]

  @@map("metodo_pago")
}

// 1 Pago = 1 Cuota (Grupo B). Se eliminó clienteId (redundante: se llega al
// cliente vía cuota → cliente, evitando inconsistencias de datos duplicados).
model Pago {
  id                 Int      @id @default(autoincrement())
  cuotaId            Int      @unique @map("cuota_id")
  metodoPagoId       Int      @map("metodo_pago_id")
  monto              Decimal  @db.Decimal(10, 2)
  fechaPago          DateTime @map("fecha_pago")
  referenciaExterna  String?  @map("referencia_externa") @db.VarChar(200)

  cuota      Cuota      @relation(fields: [cuotaId], references: [id])
  metodoPago MetodoPago @relation(fields: [metodoPagoId], references: [id])

  @@map("pago")
}

// Promociones sobre planes (RF-46A). No existía en la BDD vieja.
model Promocion {
  id           Int       @id @default(autoincrement())
  planId       Int       @map("plan_id")
  nombre       String    @db.VarChar(100)
  descripcion  String?   @db.Text
  descuento    Decimal   @db.Decimal(5, 2) // porcentaje o monto, según defina el admin
  fechaInicio  DateTime  @map("fecha_inicio") @db.Date
  fechaFin     DateTime  @map("fecha_fin") @db.Date
  activa       Boolean   @default(true)

  plan Plan @relation(fields: [planId], references: [id])

  @@map("promocion")
}

// ============================================================================
// ASISTENCIA
// ============================================================================

model Asistencia {
  id        Int      @id @default(autoincrement())
  clienteId Int      @map("cliente_id")
  fechaHora DateTime @map("fecha_hora")

  cliente Cliente @relation(fields: [clienteId], references: [id])

  @@map("asistencia")
  @@index([clienteId, fechaHora])
}

// ============================================================================
// RUTINAS Y EJERCICIOS
// ============================================================================

model Rutina {
  id                Int      @id @default(autoincrement())
  clienteId         Int      @map("cliente_id")
  profesorId        Int      @map("profesor_id")
  nombre            String   @db.VarChar(150)
  descripcion       String?  @db.Text
  objetivo          String?  @db.VarChar(150)
  frecuenciaSemanal Int?     @map("frecuencia_semanal")
  duracionEstimada  Int?     @map("duracion_estimada") // en minutos
  nivelDificultad   String?  @map("nivel_dificultad") @db.VarChar(50)

  // Puede haber MÁS DE UNA rutina activa a la vez para el mismo cliente
  // (Grupo G) — ej. una de brazos y otra de piernas, ambas vigentes.
  // "Activa" no depende del mes: una rutina sigue siendo la vigente aunque
  // haya pasado un mes, hasta que sea reemplazada por otra específicamente
  // para esos mismos días. El "historial del mes anterior" se resuelve por
  // consulta filtrando fechaAsignacion, no con una tabla separada.
  activa           Boolean  @default(true)
  fechaAsignacion  DateTime @default(now()) @map("fecha_asignacion") @db.Date

  cliente  Cliente           @relation(fields: [clienteId], references: [id])
  profesor Profesor          @relation(fields: [profesorId], references: [id])
  dias     RutinaDia[]
  ejercicios RutinaEjercicio[]

  // NOTA (Grupo G): un mismo día de la semana NO puede pertenecer a dos
  // rutinas activas distintas del mismo cliente al mismo tiempo (ej. no
  // puede haber "lunes" en la rutina de brazos Y en la de piernas si ambas
  // están activas). Esta regla cruza Cliente → Rutina → RutinaDia y por eso
  // NO se expresa como una restricción SQL simple: debe ser validada por
  // el backend antes de crear o activar una RutinaDia.

  @@map("rutina")
  @@index([clienteId, activa])
}

// Días de la semana asignados a una rutina (Grupo G). Una rutina puede
// tener varios días (ej. miércoles y jueves para la misma rutina de brazos).
// dia_semana: 1=Lunes ... 7=Domingo (convención a documentar en el backend).
model RutinaDia {
  id         Int @id @default(autoincrement())
  rutinaId   Int @map("rutina_id")
  diaSemana  Int @map("dia_semana")

  rutina Rutina @relation(fields: [rutinaId], references: [id])

  @@map("rutina_dia")
  @@unique([rutinaId, diaSemana]) // un mismo día no se repite DENTRO de la misma rutina
}

// Catálogo de ejercicios disponibles. Puede haber ejercicios "demo" (base
// del sistema, creadoPor = NULL) o cargados por un profesor específico
// (Grupo D). Solo `nombre` es obligatorio: un profesor debe poder cargar un
// ejercicio nuevo con el mínimo esfuerzo para que quede disponible en el
// catálogo general.
model Ejercicio {
  id             Int      @id @default(autoincrement())
  nombre         String   @db.VarChar(150)
  grupoMuscular  String?  @map("grupo_muscular") @db.VarChar(50)
  tipo           String?  @db.VarChar(50)
  descripcion    String?  @db.Text
  videoUrl       String?  @map("video_url") @db.VarChar(500)
  creadoPor      Int?     @map("creado_por") // NULL = ejercicio demo/base del sistema
  activo         Boolean  @default(true)
  fechaCreacion  DateTime @default(now()) @map("fecha_creacion")

  profesorCreador Profesor?         @relation(fields: [creadoPor], references: [id])
  rutinas         RutinaEjercicio[]

  @@map("ejercicio")
}

// Tabla intermedia N:M entre Rutina y Ejercicio, con atributos propios de
// la relación (series, repeticiones, etc.). Nunca incluye datos de peso o
// carga: esa funcionalidad no existe en FitLogic (decisión explícita).
model RutinaEjercicio {
  id                Int     @id @default(autoincrement())
  rutinaId          Int     @map("rutina_id")
  ejercicioId       Int     @map("ejercicio_id")
  series            Int?
  repeticiones      Int?
  descansoSegundos  Int?    @map("descanso_segundos")
  ordenVisual       Int?    @map("orden_visual")
  observaciones     String? @db.Text

  rutina    Rutina    @relation(fields: [rutinaId], references: [id])
  ejercicio Ejercicio @relation(fields: [ejercicioId], references: [id])

  @@map("rutina_ejercicio")
}

// ============================================================================
// CLASES
// ============================================================================

model Clase {
  id          Int      @id @default(autoincrement())
  profesorId  Int      @map("profesor_id")
  nombre      String   @db.VarChar(100)
  sala        String?  @db.VarChar(100)
  cupoMaximo  Int      @map("cupo_maximo")
  recurrente  Boolean  @default(false)
  fechaHora   DateTime @map("fecha_hora")

  profesor      Profesor           @relation(fields: [profesorId], references: [id])
  inscripciones InscripcionClase[]
  puntuaciones  PuntuacionClase[]

  @@map("clase")
}

// Catálogo de estados de inscripción (Grupo A: tabla, no enum).
model EstadoInscripcion {
  id            Int                @id @default(autoincrement())
  nombre        String             @unique @db.VarChar(50) // INSCRIPTO | CANCELADO | ASISTIO
  inscripciones InscripcionClase[]

  @@map("estado_inscripcion")
}

model InscripcionClase {
  id                  Int      @id @default(autoincrement())
  claseId             Int      @map("clase_id")
  clienteId           Int      @map("cliente_id")
  estadoInscripcionId Int      @map("estado_inscripcion_id")
  fechaInscripcion    DateTime @default(now()) @map("fecha_inscripcion")

  clase             Clase             @relation(fields: [claseId], references: [id])
  cliente           Cliente           @relation(fields: [clienteId], references: [id])
  estadoInscripcion EstadoInscripcion @relation(fields: [estadoInscripcionId], references: [id])

  @@map("inscripcion_clase")
  @@unique([claseId, clienteId]) // un cliente no puede inscribirse dos veces a la misma clase
}

// Puntuación de 1 a 5, solo si el cliente estuvo inscripto y la clase ya
// finalizó (regla validada por el backend, no por la BDD).
model PuntuacionClase {
  id          Int     @id @default(autoincrement())
  claseId     Int     @map("clase_id")
  clienteId   Int     @map("cliente_id")
  puntuacion  Int     @db.TinyInt
  comentario  String? @db.VarChar(500)

  clase   Clase   @relation(fields: [claseId], references: [id])
  cliente Cliente @relation(fields: [clienteId], references: [id])

  @@map("puntuacion_clase")
  @@unique([claseId, clienteId]) // una sola puntuación por cliente y clase
  // NOTA: la restricción "puntuacion BETWEEN 1 AND 5" se agrega como CHECK
  // vía SQL nativo (ver migración adjunta), ya que Prisma no la expresa
  // directamente en el schema.
}

// ============================================================================
// RECETAS
// ============================================================================

// Catálogo de categorías de receta.
model CategoriaReceta {
  id      Int      @id @default(autoincrement())
  nombre  String   @unique @db.VarChar(50) // DESAYUNO | ALMUERZO | MERIENDA | CENA
  recetas Receta[]

  @@map("categoria_receta")
}

model Receta {
  id                 Int     @id @default(autoincrement())
  profesorId         Int     @map("profesor_id")
  categoriaRecetaId  Int     @map("categoria_receta_id")
  nombre             String  @db.VarChar(150)
  descripcion        String? @db.Text
  calorias           Int?
  tiempoPreparacion  Int?    @map("tiempo_preparacion") // en minutos
  foto               String? @db.VarChar(255)

  profesor        Profesor          @relation(fields: [profesorId], references: [id])
  categoriaReceta CategoriaReceta   @relation(fields: [categoriaRecetaId], references: [id])
  ingredientes    IngredienteReceta[]
  pasos           PasoReceta[]

  @@map("receta")
}

model IngredienteReceta {
  id        Int     @id @default(autoincrement())
  recetaId  Int     @map("receta_id")
  nombre    String  @db.VarChar(150)
  cantidad  String? @db.VarChar(50)
  unidad    String? @db.VarChar(30)

  receta Receta @relation(fields: [recetaId], references: [id])

  @@map("ingrediente_receta")
}

model PasoReceta {
  id          Int    @id @default(autoincrement())
  recetaId    Int    @map("receta_id")
  numeroPaso  Int    @map("numero_paso")
  descripcion String @db.Text

  receta Receta @relation(fields: [recetaId], references: [id])

  @@map("paso_receta")
  @@unique([recetaId, numeroPaso])
}

// ============================================================================
// NOTIFICACIONES
// ============================================================================

// Catálogo de tipos de notificación (Grupo A: tabla, no enum).
model TipoNotificacion {
  id             Int            @id @default(autoincrement())
  nombre         String         @unique @db.VarChar(50)
  notificaciones Notificacion[]

  @@map("tipo_notificacion")
}

model Notificacion {
  id                 Int      @id @default(autoincrement())
  usuarioId          Int      @map("usuario_id")
  tipoNotificacionId Int      @map("tipo_notificacion_id")
  titulo             String   @db.VarChar(150)
  mensaje            String   @db.Text
  leida              Boolean  @default(false)
  fechaEnvio         DateTime @default(now()) @map("fecha_envio")

  usuario          Usuario          @relation(fields: [usuarioId], references: [id])
  tipoNotificacion TipoNotificacion @relation(fields: [tipoNotificacionId], references: [id])

  @@map("notificacion")
  @@index([usuarioId, leida])
}
