generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Rol {
  id       Int       @id
  nombre   String    @db.VarChar(50)
  usuarios Usuario[]

  @@map("roles")
}

model EstadoCliente {
  id       Int       @id
  nombre   String?   @db.VarChar(50)
  clientes Cliente[]

  @@map("estados_cliente")
}

model EstadoCuota {
  id     Int     @id
  nombre String? @db.VarChar(50)
  cuotas Cuota[]

  @@map("estados_cuota")
}

model Gimnasio {
  id               Int                   @id @default(autoincrement())
  codigo           String                @unique @db.VarChar(50)
  nombre           String                @db.VarChar(100)
  direccion        String?               @db.VarChar(200)
  telefono         String?               @db.VarChar(50)
  email            String?               @db.VarChar(100)
  telefonoSoporte  String?               @map("telefono_soporte") @db.VarChar(50)
  emailSoporte     String?               @map("email_soporte") @db.VarChar(100)
  horarioAtencion  String?               @map("horario_atencion") @db.VarChar(200)
  activo           Int                   @default(1) @db.TinyInt
  fechaCreacion    DateTime              @default(now()) @map("fecha_creacion")
  usuarios         Usuario[]
  planes           Plan[]
  productos        Producto[]
  configuracion    ConfiguracionGimnasio?
  especialidades   Especialidad[]
  ejerciciosCatalogo EjercicioCatalogo[]
  clases           Clase[]
  recetas          Receta[]
  promociones      Promocion[]
  ventas           Venta[]
  archivos         Archivo[]
  rutinas          Rutina[]
  asistencias      Asistencia[]

  @@map("gimnasios")
}

model ConfiguracionGimnasio {
  id                 Int      @id @default(autoincrement())
  gimnasioId         Int      @unique @map("gimnasio_id")
  modoSalaUnica      Int      @default(0) @map("modo_sala_unica") @db.TinyInt
  notifNuevoCliente  Int      @default(1) @map("notif_nuevo_cliente") @db.TinyInt
  notifNuevoPago     Int      @default(1) @map("notif_nuevo_pago") @db.TinyInt
  notifClaseProxima  Int      @default(1) @map("notif_clase_proxima") @db.TinyInt
  notifAptoVencido   Int      @default(1) @map("notif_apto_vencido") @db.TinyInt
  codigoSoporte      String?  @map("codigo_soporte") @db.VarChar(50)
  fechaCreacion      DateTime @default(now()) @map("fecha_creacion")
  fechaActualizacion DateTime @default(now()) @updatedAt @map("fecha_actualizacion")
  gimnasio           Gimnasio @relation(fields: [gimnasioId], references: [id])

  @@map("configuracion_gimnasio")
}

model Usuario {
  id                 Int             @id @default(autoincrement())
  gimnasioId         Int             @map("gimnasio_id")
  rolId              Int             @map("rol_id")
  nombre             String          @db.VarChar(100)
  apellido           String          @db.VarChar(100)
  email              String          @db.VarChar(150)
  passwordHash       String          @map("password_hash") @db.VarChar(255)
  telefono           String?         @db.VarChar(50)
  activo             Int             @default(1) @db.TinyInt
  fechaCreacion      DateTime        @default(now()) @map("fecha_creacion")
  fechaActualizacion DateTime        @default(now()) @updatedAt @map("fecha_actualizacion")
  fechaEliminacion   DateTime?       @map("fecha_eliminacion")
  gimnasio           Gimnasio        @relation(fields: [gimnasioId], references: [id])
  rol                Rol             @relation(fields: [rolId], references: [id])
  cliente            Cliente?
  profesor           Profesor?
  recepcionista      Recepcionista?
  notificaciones     Notificacion[]
  archivosSubidos    Archivo[]       @relation("ArchivoSubidoPor")
  pagosRegistrados   Pago[]          @relation("PagoRegistradoPor")
  aptosSubidos       AptoFisico[]    @relation("AptoSubidoPor")
  ventasRegistradas  Venta[]         @relation("VentaRegistradaPor")

  @@unique([gimnasioId, email])
  @@index([gimnasioId])
  @@map("usuarios")
}

model Especialidad {
  id         Int                    @id @default(autoincrement())
  gimnasioId Int                    @map("gimnasio_id")
  nombre     String                 @db.VarChar(100)
  activo     Int                    @default(1) @db.TinyInt
  gimnasio   Gimnasio               @relation(fields: [gimnasioId], references: [id])
  profesores ProfesorEspecialidad[]

  @@unique([gimnasioId, nombre])
  @@index([gimnasioId])
  @@map("especialidades")
}

model ProfesorEspecialidad {
  profesorId      Int          @map("profesor_id")
  especialidadId  Int          @map("especialidad_id")
  profesor        Profesor     @relation(fields: [profesorId], references: [id], onDelete: Cascade)
  especialidad    Especialidad @relation(fields: [especialidadId], references: [id], onDelete: Cascade)

  @@id([profesorId, especialidadId])
  @@map("profesor_especialidades")
}

model Cliente {
  id                     Int                @id @default(autoincrement())
  usuarioId              Int                @unique @map("usuario_id")
  estadoClienteId        Int                @map("estado_cliente_id")
  objetivoDiasSemana     Int                @default(3) @map("objetivo_dias_semana")
  objetivoEntrenamiento  String?            @map("objetivo_entrenamiento") @db.VarChar(200)
  observacionesMedicas   String?            @map("observaciones_medicas") @db.Text
  rachaActual            Int                @default(0) @map("racha_actual")
  fechaAlta              DateTime?          @map("fecha_alta") @db.Date
  fechaBaja              DateTime?          @map("fecha_baja") @db.Date
  usuario                Usuario            @relation(fields: [usuarioId], references: [id])
  estadoCliente          EstadoCliente      @relation(fields: [estadoClienteId], references: [id])
  cuotas                 Cuota[]
  pagos                  Pago[]
  aptosFisicos           AptoFisico[]
  asistencias            Asistencia[]
  rutinas                Rutina[]
  inscripciones          InscripcionClase[]
  puntuaciones           PuntuacionClase[]
  ventas                 Venta[]

  @@index([estadoClienteId])
  @@map("clientes")
}

model Profesor {
  id             Int                    @id @default(autoincrement())
  usuarioId      Int                    @unique @map("usuario_id")
  especialidad   String?                @db.VarChar(100)
  usuario        Usuario                @relation(fields: [usuarioId], references: [id])
  rutinas        Rutina[]
  recetas        Receta[]
  clases         Clase[]
  especialidades ProfesorEspecialidad[]

  @@map("profesores")
}

model Recepcionista {
  id        Int     @id @default(autoincrement())
  usuarioId Int     @unique @map("usuario_id")
  usuario   Usuario @relation(fields: [usuarioId], references: [id])

  @@map("recepcionistas")
}

model Plan {
  id                 Int             @id @default(autoincrement())
  gimnasioId         Int             @map("gimnasio_id")
  nombre             String?         @db.VarChar(100)
  duracionDias       Int?            @map("duracion_dias")
  precio             Decimal?        @db.Decimal(10, 2)
  activo             Int             @default(1) @db.TinyInt
  fechaCreacion      DateTime        @default(now()) @map("fecha_creacion")
  fechaActualizacion DateTime        @default(now()) @updatedAt @map("fecha_actualizacion")
  fechaEliminacion   DateTime?       @map("fecha_eliminacion")
  creadoPorId        Int?            @map("creado_por_id")
  actualizadoPorId   Int?            @map("actualizado_por_id")
  gimnasio           Gimnasio        @relation(fields: [gimnasioId], references: [id])
  cuotas             Cuota[]
  promociones        PromocionPlan[]

  @@index([gimnasioId])
  @@map("planes")
}

model Cuota {
  id                 Int          @id @default(autoincrement())
  clienteId          Int          @map("cliente_id")
  planId             Int          @map("plan_id")
  estadoCuotaId      Int          @map("estado_cuota_id")
  fechaInicio        DateTime?    @map("fecha_inicio") @db.Date
  fechaVencimiento   DateTime?    @map("fecha_vencimiento") @db.Date
  fechaCreacion      DateTime     @default(now()) @map("fecha_creacion")
  fechaActualizacion DateTime     @default(now()) @updatedAt @map("fecha_actualizacion")
  creadoPorId        Int?         @map("creado_por_id")
  actualizadoPorId   Int?         @map("actualizado_por_id")
  cliente            Cliente      @relation(fields: [clienteId], references: [id])
  plan               Plan         @relation(fields: [planId], references: [id])
  estadoCuota        EstadoCuota  @relation(fields: [estadoCuotaId], references: [id])
  pagos              Pago[]

  @@index([clienteId])
  @@index([estadoCuotaId])
  @@map("cuotas")
}

model Pago {
  id                Int       @id @default(autoincrement())
  clienteId         Int       @map("cliente_id")
  cuotaId           Int?      @map("cuota_id")
  ventaId           Int?      @map("venta_id")
  tipoPago          Int       @default(1) @map("tipo_pago")
  monto             Decimal?  @db.Decimal(10, 2)
  fechaPago         DateTime? @map("fecha_pago")
  metodoPago        Int?      @map("metodo_pago")
  estadoPago        Int?      @map("estado_pago")
  referenciaExterna String?   @map("referencia_externa") @db.VarChar(200)
  registradoPorId   Int?      @map("registrado_por_id")
  fechaCreacion     DateTime  @default(now()) @map("fecha_creacion")
  cliente           Cliente   @relation(fields: [clienteId], references: [id])
  cuota             Cuota?    @relation(fields: [cuotaId], references: [id])
  venta             Venta?    @relation(fields: [ventaId], references: [id])
  registradoPor     Usuario?  @relation("PagoRegistradoPor", fields: [registradoPorId], references: [id])

  @@index([clienteId])
  @@index([cuotaId])
  @@index([ventaId])
  @@map("pagos")
}

model Archivo {
  id             Int          @id @default(autoincrement())
  gimnasioId     Int          @map("gimnasio_id")
  nombreOriginal String       @map("nombre_original") @db.VarChar(255)
  ruta           String       @db.VarChar(500)
  mimeType       String       @map("mime_type") @db.VarChar(100)
  tamanoBytes    Int          @map("tamano_bytes")
  subidoPorId    Int?         @map("subido_por_id")
  fechaCreacion  DateTime     @default(now()) @map("fecha_creacion")
  gimnasio       Gimnasio     @relation(fields: [gimnasioId], references: [id])
  subidoPor      Usuario?     @relation("ArchivoSubidoPor", fields: [subidoPorId], references: [id])
  aptosFisicos   AptoFisico[]
  productos      Producto[]   @relation("ProductoFoto")
  recetas        Receta[]     @relation("RecetaFoto")

  @@index([gimnasioId])
  @@map("archivos")
}

model AptoFisico {
  id               Int       @id @default(autoincrement())
  clienteId        Int       @map("cliente_id")
  archivoId        Int?      @map("archivo_id")
  archivo          String?   @db.VarChar(255)
  fechaCarga       DateTime? @map("fecha_carga") @db.Date
  fechaVencimiento DateTime? @map("fecha_vencimiento") @db.Date
  estado           Int       @default(1)
  subidoPorId      Int?      @map("subido_por_id")
  fechaCreacion    DateTime  @default(now()) @map("fecha_creacion")
  cliente          Cliente   @relation(fields: [clienteId], references: [id])
  archivoRef       Archivo?  @relation(fields: [archivoId], references: [id])
  subidoPor        Usuario?  @relation("AptoSubidoPor", fields: [subidoPorId], references: [id])

  @@index([clienteId])
  @@map("aptos_fisicos")
}

model Asistencia {
  id        Int       @id @default(autoincrement())
  gimnasioId Int      @map("gimnasio_id")
  clienteId Int       @map("cliente_id")
  fechaHora DateTime? @map("fecha_hora")
  origen    Int       @default(2)
  gimnasio  Gimnasio  @relation(fields: [gimnasioId], references: [id])
  cliente   Cliente   @relation(fields: [clienteId], references: [id])

  @@index([gimnasioId])
  @@index([clienteId])
  @@index([fechaHora])
  @@map("asistencias")
}

model EjercicioCatalogo {
  id            Int               @id @default(autoincrement())
  gimnasioId    Int               @map("gimnasio_id")
  nombre        String            @db.VarChar(150)
  categoria     String?           @db.VarChar(100)
  activo        Int               @default(1) @db.TinyInt
  creadoPorId   Int?              @map("creado_por_id")
  fechaCreacion DateTime          @default(now()) @map("fecha_creacion")
  gimnasio      Gimnasio          @relation(fields: [gimnasioId], references: [id])
  ejercicios    EjercicioRutina[]

  @@index([gimnasioId])
  @@map("ejercicios_catalogo")
}

model Rutina {
  id                 Int               @id @default(autoincrement())
  gimnasioId         Int               @map("gimnasio_id")
  clienteId          Int?              @map("cliente_id")
  profesorId         Int?              @map("profesor_id")
  nombre             String?           @db.VarChar(150)
  descripcion        String?           @db.Text
  categoria          String?           @db.VarChar(50)
  gruposMusculares   String?           @map("grupos_musculares") @db.Text
  activa             Int               @default(1) @db.TinyInt
  fechaAsignacion    DateTime?         @map("fecha_asignacion") @db.Date
  fechaCreacion      DateTime          @default(now()) @map("fecha_creacion")
  fechaActualizacion DateTime          @default(now()) @updatedAt @map("fecha_actualizacion")
  creadoPorId        Int?              @map("creado_por_id")
  actualizadoPorId   Int?              @map("actualizado_por_id")
  gimnasio           Gimnasio          @relation(fields: [gimnasioId], references: [id])
  cliente            Cliente?          @relation(fields: [clienteId], references: [id])
  profesor           Profesor?         @relation(fields: [profesorId], references: [id])
  ejercicios         EjercicioRutina[]
  dias               RutinaDia[]

  @@index([gimnasioId])
  @@index([clienteId])
  @@index([profesorId])
  @@map("rutinas")
}

model EjercicioRutina {
  id                  Int                @id @default(autoincrement())
  rutinaId            Int                @map("rutina_id")
  ejercicioCatalogoId Int?               @map("ejercicio_catalogo_id")
  nombre              String?            @db.VarChar(150)
  series              Int?
  repeticiones        Int?
  peso                Decimal?           @db.Decimal(8, 2)
  descansoSegundos    Int?               @map("descanso_segundos")
  diaSemana           Int?               @map("dia_semana")
  descripcion         String?            @db.Text
  ordenVisual         Int?               @map("orden_visual")
  rutina              Rutina             @relation(fields: [rutinaId], references: [id], onDelete: Cascade)
  ejercicioCatalogo   EjercicioCatalogo? @relation(fields: [ejercicioCatalogoId], references: [id])

  @@index([rutinaId])
  @@index([ejercicioCatalogoId])
  @@map("ejercicios_rutina")
}

model RutinaDia {
  id        Int     @id @default(autoincrement())
  rutinaId  Int?    @map("rutina_id")
  diaSemana Int?    @map("dia_semana")
  rutina    Rutina? @relation(fields: [rutinaId], references: [id], onDelete: Cascade)

  @@index([rutinaId])
  @@map("rutina_dias")
}

model Receta {
  id                 Int                @id @default(autoincrement())
  gimnasioId         Int                @map("gimnasio_id")
  profesorId         Int?               @map("profesor_id")
  categoria          Int?
  nombre             String?            @db.VarChar(150)
  descripcion        String?            @db.Text
  calorias           Int?
  proteinas          Int?
  carbohidratos      Int?
  grasas             Int?
  tiempoPreparacion  Int?               @map("tiempo_preparacion")
  foto               String?            @db.VarChar(255)
  fotoId             Int?               @map("foto_id")
  activo             Int                @default(1) @db.TinyInt
  fechaCreacion      DateTime           @default(now()) @map("fecha_creacion")
  fechaActualizacion DateTime           @default(now()) @updatedAt @map("fecha_actualizacion")
  creadoPorId        Int?               @map("creado_por_id")
  actualizadoPorId   Int?               @map("actualizado_por_id")
  gimnasio           Gimnasio           @relation(fields: [gimnasioId], references: [id])
  profesor           Profesor?          @relation(fields: [profesorId], references: [id])
  fotoRef            Archivo?           @relation("RecetaFoto", fields: [fotoId], references: [id])
  ingredientes       RecetaIngrediente[]
  pasos              RecetaPaso[]

  @@index([gimnasioId])
  @@index([profesorId])
  @@map("recetas")
}

model RecetaIngrediente {
  id          Int    @id @default(autoincrement())
  recetaId    Int    @map("receta_id")
  orden       Int
  descripcion String @db.VarChar(500)
  receta      Receta @relation(fields: [recetaId], references: [id], onDelete: Cascade)

  @@index([recetaId])
  @@map("receta_ingredientes")
}

model RecetaPaso {
  id          Int    @id @default(autoincrement())
  recetaId    Int    @map("receta_id")
  orden       Int
  descripcion String @db.Text
  receta      Receta @relation(fields: [recetaId], references: [id], onDelete: Cascade)

  @@index([recetaId])
  @@map("receta_pasos")
}

model Clase {
  id                 Int                @id @default(autoincrement())
  gimnasioId         Int                @map("gimnasio_id")
  profesorId         Int?               @map("profesor_id")
  nombre             String?            @db.VarChar(100)
  sala               String?            @db.VarChar(100)
  cupoMaximo         Int?               @map("cupo_maximo")
  recurrente         Int?               @db.TinyInt
  diaSemana          Int?               @map("dia_semana")
  horaInicio         String?            @map("hora_inicio") @db.VarChar(8)
  horaFin            String?            @map("hora_fin") @db.VarChar(8)
  activa             Int                @default(1) @db.TinyInt
  fechaCreacion      DateTime           @default(now()) @map("fecha_creacion")
  fechaActualizacion DateTime           @default(now()) @updatedAt @map("fecha_actualizacion")
  creadoPorId        Int?               @map("creado_por_id")
  actualizadoPorId   Int?               @map("actualizado_por_id")
  gimnasio           Gimnasio           @relation(fields: [gimnasioId], references: [id])
  profesor           Profesor?          @relation(fields: [profesorId], references: [id])
  inscripciones      InscripcionClase[]
  puntuaciones       PuntuacionClase[]

  @@index([gimnasioId])
  @@index([profesorId])
  @@map("clases")
}

model InscripcionClase {
  id               Int       @id @default(autoincrement())
  claseId          Int       @map("clase_id")
  clienteId        Int       @map("cliente_id")
  estado           Int       @default(1)
  fechaInscripcion DateTime? @map("fecha_inscripcion")
  clase            Clase     @relation(fields: [claseId], references: [id])
  cliente          Cliente   @relation(fields: [clienteId], references: [id])

  @@unique([claseId, clienteId])
  @@index([claseId])
  @@index([clienteId])
  @@map("inscripciones_clase")
}

model PuntuacionClase {
  id          Int      @id @default(autoincrement())
  claseId     Int      @map("clase_id")
  clienteId   Int      @map("cliente_id")
  fechaSesion DateTime @map("fecha_sesion") @db.Date
  puntuacion  Int?
  comentario  String?  @db.VarChar(500)
  clase       Clase    @relation(fields: [claseId], references: [id])
  cliente     Cliente  @relation(fields: [clienteId], references: [id])

  @@unique([claseId, clienteId, fechaSesion])
  @@map("puntuaciones_clase")
}

model Producto {
  id                 Int                 @id @default(autoincrement())
  gimnasioId         Int                 @map("gimnasio_id")
  categoria          Int?
  nombre             String?             @db.VarChar(150)
  descripcion        String?             @db.Text
  precio             Decimal?            @db.Decimal(10, 2)
  precioOriginal     Decimal?            @map("precio_original") @db.Decimal(10, 2)
  enOferta           Int                 @default(0) @map("en_oferta") @db.TinyInt
  stock              Int?
  foto               String?             @db.VarChar(255)
  fotoId             Int?                @map("foto_id")
  activo             Int                 @default(1) @db.TinyInt
  fechaCreacion      DateTime            @default(now()) @map("fecha_creacion")
  fechaActualizacion DateTime            @default(now()) @updatedAt @map("fecha_actualizacion")
  fechaEliminacion   DateTime?           @map("fecha_eliminacion")
  creadoPorId        Int?                @map("creado_por_id")
  actualizadoPorId   Int?                @map("actualizado_por_id")
  gimnasio           Gimnasio            @relation(fields: [gimnasioId], references: [id])
  fotoRef            Archivo?            @relation("ProductoFoto", fields: [fotoId], references: [id])
  ventaItems         VentaItem[]
  promociones        PromocionProducto[]

  @@index([gimnasioId])
  @@map("productos")
}

model Promocion {
  id                  Int                 @id @default(autoincrement())
  gimnasioId          Int                 @map("gimnasio_id")
  nombre              String              @db.VarChar(150)
  descripcion         String?             @db.Text
  descuentoPorcentaje Decimal             @map("descuento_porcentaje") @db.Decimal(5, 2)
  tipo                Int
  fechaInicio         DateTime            @map("fecha_inicio") @db.Date
  fechaFin            DateTime            @map("fecha_fin") @db.Date
  activo              Int                 @default(1) @db.TinyInt
  fechaCreacion       DateTime            @default(now()) @map("fecha_creacion")
  fechaActualizacion  DateTime            @default(now()) @updatedAt @map("fecha_actualizacion")
  creadoPorId         Int?                @map("creado_por_id")
  actualizadoPorId    Int?                @map("actualizado_por_id")
  gimnasio            Gimnasio            @relation(fields: [gimnasioId], references: [id])
  productos           PromocionProducto[]
  planes              PromocionPlan[]

  @@index([gimnasioId])
  @@map("promociones")
}

model PromocionProducto {
  promocionId Int       @map("promocion_id")
  productoId  Int       @map("producto_id")
  promocion   Promocion @relation(fields: [promocionId], references: [id], onDelete: Cascade)
  producto    Producto  @relation(fields: [productoId], references: [id], onDelete: Cascade)

  @@id([promocionId, productoId])
  @@map("promocion_productos")
}

model PromocionPlan {
  promocionId Int       @map("promocion_id")
  planId      Int       @map("plan_id")
  promocion   Promocion @relation(fields: [promocionId], references: [id], onDelete: Cascade)
  plan        Plan      @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@id([promocionId, planId])
  @@map("promocion_planes")
}

model Venta {
  id                 Int         @id @default(autoincrement())
  gimnasioId         Int         @map("gimnasio_id")
  codigo             String      @db.VarChar(50)
  canal              Int
  clienteId          Int?        @map("cliente_id")
  estado             Int         @default(1)
  montoTotal         Decimal     @map("monto_total") @db.Decimal(10, 2)
  metodoPago         Int?        @map("metodo_pago")
  referenciaExterna  String?     @map("referencia_externa") @db.VarChar(200)
  registradoPorId    Int?        @map("registrado_por_id")
  pagadoEn           DateTime?   @map("pagado_en")
  fechaCreacion      DateTime    @default(now()) @map("fecha_creacion")
  fechaActualizacion DateTime    @default(now()) @updatedAt @map("fecha_actualizacion")
  gimnasio           Gimnasio    @relation(fields: [gimnasioId], references: [id])
  cliente            Cliente?    @relation(fields: [clienteId], references: [id])
  registradoPor      Usuario?    @relation("VentaRegistradaPor", fields: [registradoPorId], references: [id])
  items              VentaItem[]
  pagos              Pago[]

  @@unique([gimnasioId, codigo])
  @@index([gimnasioId])
  @@index([clienteId])
  @@map("ventas")
}

model VentaItem {
  id             Int      @id @default(autoincrement())
  ventaId        Int      @map("venta_id")
  productoId     Int      @map("producto_id")
  cantidad       Int
  precioUnitario Decimal  @map("precio_unitario") @db.Decimal(10, 2)
  subtotal       Decimal  @db.Decimal(10, 2)
  venta          Venta    @relation(fields: [ventaId], references: [id], onDelete: Cascade)
  producto       Producto @relation(fields: [productoId], references: [id])

  @@index([ventaId])
  @@index([productoId])
  @@map("venta_items")
}

model Notificacion {
  id         Int       @id @default(autoincrement())
  usuarioId  Int       @map("usuario_id")
  tipo       Int?
  titulo     String?   @db.VarChar(150)
  mensaje    String?   @db.Text
  metadata   String?   @db.Text
  leida      Int       @default(0) @db.TinyInt
  fechaEnvio DateTime? @map("fecha_envio")
  usuario    Usuario   @relation(fields: [usuarioId], references: [id])

  @@index([usuarioId])
  @@map("notificaciones")
}