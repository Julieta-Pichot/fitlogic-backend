# ============================================================================
# FitLogic API - variables de entorno. Copiá este archivo a `.env` y completalo.
# `.env` NO se versiona (está en .gitignore): nunca subas credenciales reales.
# ============================================================================

# Conexión a MySQL/MariaDB (usuario, contraseña, host, puerto y base).
# Local:
DATABASE_URL="mysql://usuario:contraseña@127.0.0.1:3306/fitlogic"
# Producción con Aiven (valores falsos; copiá host/puerto/usuario del panel de Aiven). Usá un usuario propio de la
# app, no `avnadmin`. sslcert apunta al Secret File de Render con el CA (ca.pem). La contraseña debe ir codificada
# para URL si tiene caracteres especiales (ej.: `@` -> %40, `#` -> %23, `/` -> %2F, `:` -> %3A).
# DATABASE_URL="mysql://USUARIO:CLAVE@HOST:PUERTO/defaultdb?sslaccept=strict&sslcert=/etc/secrets/ca.pem&connection_limit=5"

# Secreto para firmar los JWT. OBLIGATORIO en producción (el servidor no arranca sin él, igual que DATABASE_URL).
# Usá un valor largo y aleatorio, distinto del de desarrollo (ej.: `openssl rand -hex 48`).
JWT_SECRET="cambiar-por-un-valor-largo-y-aleatorio"
JWT_EXPIRES_IN="7d"

# Render define PORT solo; en local por defecto 3001.
PORT=3001
NODE_ENV=development

# Origen(es) del frontend permitidos por CORS. Admite varios separados por coma (producción + previews), sin barra final.
# En producción es la ÚNICA lista de orígenes aceptados (localhost solo se acepta si NODE_ENV != production).
# Ej. producción: FRONTEND_URL="https://fitlogic.vercel.app,https://fitlogic-git-main-usuario.vercel.app"
FRONTEND_URL="http://localhost:5173"

# --- Primer administrador (solo para `npm run create-admin`; no se usan al arrancar el servidor) ---------------
# El script crea el admin únicamente si no existe ninguno. La contraseña debe tener 10+ caracteres y no se imprime.
# Quitalas del entorno después de usarlo.
# ADMIN_EMAIL="admin@tu-dominio.com"
# ADMIN_PASSWORD="reemplazar-por-una-clave-larga"
# ADMIN_NOMBRE="Administrador"
# ADMIN_APELLIDO="FitLogic"

# Tope de intentos de login fallidos por email+IP cada 15 minutos (por defecto 8)
# LOGIN_MAX_FAILURES=8

# --- Mercado Pago (Checkout Pro) ---------------------------------------------
# Credenciales de PRUEBA del USUARIO VENDEDOR DE PRUEBA de tu aplicación (Tus integraciones > Cuentas de prueba).
# El Access Token vive solo en el backend: nunca llega al front ni se loguea.
MERCADOPAGO_ACCESS_TOKEN="APP_USR-reemplazar"
# (El backend actual no la usa; se deja por referencia.)
MERCADOPAGO_PUBLIC_KEY="APP_USR-reemplazar"

# Clave secreta del webhook (Tus integraciones > Webhooks). Opcional: si está, se valida la firma x-signature.
MERCADOPAGO_WEBHOOK_SECRET=""

# Tolerancia (segundos) para rechazar notificaciones de webhook viejas (anti-replay). Por defecto 600.
MERCADOPAGO_WEBHOOK_TOLERANCE_SECONDS="600"

# En producción: la URL https de Render (ej.: https://fitlogic-api.onrender.com).
# URL pública (https) del backend para el webhook de Mercado Pago. En local MP no puede llegar a
# localhost: levantá un túnel (ngrok / cloudflared) y pegá acá su URL https. Si es http, no se envía notification_url.
BACKEND_PUBLIC_URL="http://localhost:3001"

# URL pública (https) del frontend para las back_urls y el auto_return. Mercado Pago NO admite localhost en las
# back_urls al volver: para probar el retorno automático, exponé el front con un túnel. Por defecto usa FRONTEND_URL.
FRONTEND_PUBLIC_URL=""

# true = usar sandbox_init_point en vez de init_point (por defecto init_point).
MERCADOPAGO_USE_SANDBOX_URL="false"

# Solo para desarrollo / tests (no usar en producción):
# DISABLE_SCHEDULER=true        no arranca el scheduler de avisos y sondeo de pagos
# MERCADOPAGO_API_URL=...       apunta a un Mercado Pago simulado (los tests lo usan)
# LOG_LEVEL=info
