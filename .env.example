# Copiá este archivo a .env y completá los valores reales.
# Ninguno de los valores de abajo es un secreto real: son solo ejemplos.

# Cadena de conexión a MySQL/MariaDB (formato que espera Prisma).
DATABASE_URL="mysql://usuario:password@localhost:3306/fitlogic"

# Clave usada para firmar los JWT de sesión. Usá una cadena larga y aleatoria
# propia — nunca reutilices un valor de ejemplo en un entorno real.
JWT_SECRET="reemplazar-por-una-clave-larga-y-aleatoria"

# Duración del token de sesión.
JWT_EXPIRES_IN="24h"

# Puerto donde escucha la API.
PORT=3001

# development | production
NODE_ENV=development

# URL del frontend, para la whitelist de CORS.
FRONTEND_URL="http://localhost:5173"
